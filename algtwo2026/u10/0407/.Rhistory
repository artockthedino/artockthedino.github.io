} else {
if(length(cannies)==2){
return(c(0,nrounds))
}
jj = which(vcs==min(vcs))
if(length(jj)>1){
return(c(0,nrounds))
}
# print(jj)
cannies = cannies[-jj]
}
}
return(c(whowon,nrounds))
}
while(T){
nc = sample(4:6,1)
nv = sample(8:12,1)
prefs = list()
for(i in 1:nv){
pref = sample(1:nc)
prefs[[i]] = pref
}
cond = condorcet(prefs)
plur = plurality(prefs)
bord = borda(prefs)
inru = inst_run(prefs)[1]
inruro = inst_run(prefs)[2]
has1 = rep(F,nc)
for(i in 1:nv){
for(j in 1:nc){
if(prefs[[i]][j]==1){
has1[j] = T
}
}
}
if(inru!=0 && inruro>1 && inru!=plur && length(unique(has1))==1){
break
}
}
cans = LETTERS[26-nc+1:nc]
bp = borda_pts(prefs)
ach = sort(unique(c(bp,sample(c(bp-1,bp+1,bp-2,bp+2))))[1:10])
while(length(ach)<10){
ach = sort(unique(c(ach,sample(1:(max(bp)+10),1))))
}
al2 = paste0("* Candidate ",cans,collapse="\n")
sol = paste0(1*(1:nc==inru),collapse="")
compare = function(prefs,i,j){
pi = 0
pj = 0
for(k in 1:nv){
prefi = prefs[[k]][i]
prefj = prefs[[k]][j]
if(prefi < prefj){
pi = pi+1
}
if(prefj < prefi){
pj = pj+1
}
}
if(pi>pj){
win = i
lose = j
}
if(pj>pi){
win = j
lose = i
}
if(pj==pi){
win = 0
lose = 0
}
return(c(pi,pj,win,lose))
}
condorcet = function(prefs){
nv = length(prefs)
nc = length(prefs[[1]])
alwayswin = rep(T,nc)
for(i in 1:(nc-1)){
for(j in (i+1):nc){
pi = 0
pj = 0
for(k in 1:nv){
prefi = prefs[[k]][i]
prefj = prefs[[k]][j]
if(prefi < prefj){
pi = pi+1
}
if(prefj < prefi){
pj = pj+1
}
}
if(pi <= pj){
alwayswin[i] = F
}
if(pi >= pj){
alwayswin[j] = F
}
}
}
if(length(unique(alwayswin))==2){
return(which(alwayswin))
} else {
return(0)
}
}
plurality = function(prefs){
nv = length(prefs)
nc = length(prefs[[1]])
points = rep(0,nc)
for(k in 1:nv){
wo = which(prefs[[k]]==1)
points[wo] = points[wo]+1
}
mp = max(points)
if(sum(mp==points)==1){
return(which(points==mp))
} else {
return(0)
}
}
borda = function(prefs){
np = length(prefs)
nc = length(prefs[[1]])
bps = rep(0,nc)
for(i in 1:np){
for(j in 1:nc){
bp = nc-prefs[[i]][j]
bps[j] = bps[j]+bp
}
}
win = which(bps==max(bps))
if(length(win)>1){
return(0)
} else {
return(win)
}
}
borda_pts = function(prefs){
np = length(prefs)
nc = length(prefs[[1]])
bps = rep(0,nc)
for(i in 1:np){
for(j in 1:nc){
bp = nc-prefs[[i]][j]
bps[j] = bps[j]+bp
}
}
return(bps)
}
inst_run = function(prefs){
counts = rep(1,length(prefs))
nrounds = 0
whowon = 0
N = sum(counts)
np = length(prefs)
nc = length(prefs[[1]])
majority = N%/%2+1
winner = F
cannies = 1:nc
ppp = 0
while(winner==F){
ppp = ppp+1
if(ppp>(nc)){
break
}
# print(cannies)
nrounds = nrounds+1
vcs = rep(0,length(cannies))
for(i in 1:np){
p = prefs[[i]]
jj = which(p==min(p[cannies]))
vcs[which(cannies==jj)] = vcs[which(cannies==jj)]+counts[i]
}
# print(vcs)
if(max(vcs)>=majority){
winner=T
whowon = cannies[which(vcs==max(vcs))]
} else {
if(length(cannies)==2){
return(c(0,nrounds))
}
jj = which(vcs==min(vcs))
if(length(jj)>1){
return(c(0,nrounds))
}
# print(jj)
cannies = cannies[-jj]
}
}
return(c(whowon,nrounds))
}
